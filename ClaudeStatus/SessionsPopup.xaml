<Window x:Class="ClaudeStatus.SessionsPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Status sessions" Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        FontFamily="{StaticResource TextFont}" Foreground="{StaticResource TextPrimary}">
  <Border x:Name="Root" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}"
          BorderThickness="1" CornerRadius="8">
    <Border.RenderTransform>
      <TranslateTransform x:Name="RootShift" />
    </Border.RenderTransform>
    <StackPanel Margin="0,10,0,8">
      <TextBlock Text="Claude Code sessions" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="16,0,16,6" />
      <StackPanel x:Name="Rows" />
    </StackPanel>
  </Border>
</Window>
