<Application x:Class="ClaudeStatus.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <SolidColorBrush x:Key="Surface" Color="#FF202020" />
    <SolidColorBrush x:Key="Stroke" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#B3FFFFFF" />
  </Application.Resources>
</Application>
