<Window x:Class="ClaudeStatus.BarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Status" Width="60" Height="40"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        FontFamily="{StaticResource TextFont}">
  <!-- Hovering anywhere on the bar opens the list of sessions -->
  <Border x:Name="Bar" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}"
          BorderThickness="1" CornerRadius="6">
    <Border.ContextMenu>
      <ContextMenu Opened="Menu_Opened">
        <MenuItem Header="Quit Claude Status" Click="Quit_Click" />
      </ContextMenu>
    </Border.ContextMenu>
    <StackPanel x:Name="BarContent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
      <!-- One spark per open session -->
      <StackPanel x:Name="Dots" Orientation="Horizontal" VerticalAlignment="Center" />
    </StackPanel>
  </Border>
</Window>
